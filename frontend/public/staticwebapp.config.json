{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/sw.js", "/manifest.webmanifest", "/favicon.ico", "/*.png", "/*.svg", "/*.ico", "/api/*", "/health"]
  },
  "routes": [
    { "route": "/api/*", "allowedRoles": ["anonymous"] },
    { "route": "/health", "allowedRoles": ["anonymous"] },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } }
  ],
  "mimeTypes": { ".webmanifest": "application/manifest+json" },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
