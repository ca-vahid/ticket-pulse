}

model CompetencyAnalysisStep {
  id           Int                   @id @default(autoincrement())
  runId        Int                   @map("run_id")
  run          CompetencyAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepNumber   Int                   @map("step_number")
  stepName     String                @map("step_name") @db.VarChar(50)
  status       String                @default("running") @db.VarChar(20)
  durationMs   Int?                  @map("duration_ms")
  input        Json?
  output       Json?
  llmResponse  String?               @map("llm_response") @db.Text
  tokensUsed   Int?                  @map("tokens_used")
  errorMessage String?               @map("error_message") @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([runId])
  @@index([stepName])
  @@map("competency_analysis_steps")
}

model SummitWorkshopSession {
  id            Int       @id @default(autoincrement())
  workspaceId   Int       @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  title         String    @db.VarChar(160)
  status        String    @default("active") @db.VarChar(30)
  state         Json
  baselineState Json      @map("baseline_state")
  activeVersion Int       @default(1) @map("active_version")
  voteToken     String?   @unique @map("vote_token") @db.VarChar(80)
  voteEnabled   Boolean   @default(false) @map("vote_enabled")
  voteExpiresAt DateTime? @map("vote_expires_at")
  lastSavedBy   String?   @map("last_saved_by") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  snapshots    SummitWorkshopSnapshot[]
  participants SummitWorkshopParticipant[]
  votes        SummitWorkshopVote[]

  @@index([workspaceId])
  @@index([status])
  @@index([voteToken])
  @@map("summit_workshop_sessions")
}

model SummitWorkshopSnapshot {
  id           Int                   @id @default(autoincrement())
  sessionId    Int                   @map("session_id")
  session      SummitWorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version      Int
  label        String?               @db.VarChar(160)
  snapshotType String                @default("manual") @map("snapshot_type") @db.VarChar(30)
  state        Json
  createdBy    String?               @map("created_by") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("summit_workshop_snapshots")
}

model SummitWorkshopParticipant {
  id             Int                   @id @default(autoincrement())
  sessionId      Int                   @map("session_id")
  session        SummitWorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantKey String                @unique @map("participant_key") @db.VarChar(80)
  displayName    String                @map("display_name") @db.VarChar(120)
  createdAt      DateTime              @default(now()) @map("created_at")
  lastSeenAt     DateTime              @default(now()) @map("last_seen_at")

  votes SummitWorkshopVote[]

  @@index([sessionId])
  @@map("summit_workshop_participants")
}

model SummitWorkshopVote {
  id            Int                       @id @default(autoincrement())
  sessionId     Int                       @map("session_id")
  session       SummitWorkshopSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId Int                       @map("participant_id")
  participant   SummitWorkshopParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  itemId        String                    @map("item_id") @db.VarChar(120)
  itemType      String                    @map("item_type") @db.VarChar(30)
  itemLabel     String                    @map("item_label") @db.VarChar(255)
  voteType      String                    @map("vote_type") @db.VarChar(40)
  value         Json?
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  @@unique([participantId, itemId, voteType])
  @@index([sessionId])
  @@index([itemId])
  @@index([voteType])
  @@map("summit_workshop_votes")
}

// Per-user saved ticket-filter views (workspace-scoped). Owner is identified by
// email (no User table). Admins can flip `shared` so a view appears for everyone
// in the workspace. `params` holds the filter query (segment/status/assignee/etc.).
model SavedFilterView {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  ownerEmail  String   @map("owner_email") @db.VarChar(255)
  name        String   @db.VarChar(160)
  params      Json     @map("params")
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, ownerEmail])
  @@index([workspaceId, shared])
  @@map("saved_filter_views")
}
