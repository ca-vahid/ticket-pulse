// Ticket Pulse - FreshService Real-Time Dashboard
// Database Schema for PostgreSQL
// Multi-workspace support: all tenant-scoped tables have a workspaceId FK

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id                      Int      @id @default(autoincrement())
  name                    String   @db.VarChar(100)
  slug                    String   @unique @db.VarChar(50)
  freshserviceWorkspaceId BigInt   @map("freshservice_workspace_id")
  defaultTimezone         String   @default("America/Los_Angeles") @map("default_timezone") @db.VarChar(50)
  syncIntervalMinutes     Int      @default(5) @map("sync_interval_minutes")
  categoryCustomField     String   @default("security") @map("category_custom_field") @db.VarChar(100)
  tpSkillCustomField      String   @default("lf_ticket_pulse_category") @map("tp_skill_custom_field") @db.VarChar(100)
  tpSubskillCustomField   String   @default("lf_ticket_pulse_subcategory") @map("tp_subskill_custom_field") @db.VarChar(100)
  nativeTicketingEnabled  Boolean  @default(false) @map("native_ticketing_enabled")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  technicians                       Technician[]
  tickets                           Ticket[]
  syncLogs                          SyncLog[]
  noiseRules                        NoiseRule[]
  businessHours                     BusinessHour[]
  holidays                          Holiday[]
  autoResponses                     AutoResponse[]
  llmConfigs                        LlmConfig[]
  access                            WorkspaceAccess[]
  vacationTrackerConfig             VacationTrackerConfig?
  vtLeaveTypes                      VtLeaveType[]
  vtUserMappings                    VtUserMapping[]
  calendarLeaveConfig               CalendarLeaveSourceConfig?
  calendarLeaveRules                CalendarLeaveRule[]
  calendarLeaveAliases              CalendarLeaveAlias[]
  calendarLeaveClassifications      CalendarLeaveClassification[]
  technicianLeaves                  TechnicianLeave[]
  ticketAssignments                 TicketAssignment[]
  assignmentConfig                  AssignmentConfig?
  competencyCategories              CompetencyCategory[]
  technicianCompetencies            TechnicianCompetency[]
  assignmentPipelineRuns            AssignmentPipelineRun[]
  assignmentPrompts                 AssignmentPromptVersion[]
  competencyPrompts                 CompetencyPromptVersion[]
  competencyRuns                    CompetencyAnalysisRun[]
  competencyChangeRequests          CompetencyChangeRequest[]
  calibrationRuns                   CalibrationRun[]
  dailyReviewRuns                   AssignmentDailyReviewRun[]
  dailyReviewRecommendations        AssignmentDailyReviewRecommendation[]
  dailyReviewConsolidationRuns      AssignmentDailyReviewConsolidationRun[]
  assignmentEpisodes                TicketAssignmentEpisode[]
  backfillRuns                      BackfillRun[]
  ticketThreadEntries               TicketThreadEntry[]
  assignmentCorrections             AssignmentCorrection[]
  summitWorkshopSessions            SummitWorkshopSession[]
  skillHierarchyDrafts              SkillHierarchyDraft[]
  ticketReclassificationRuns        TicketReclassificationRun[]
  technicianNotificationPreferences TechnicianNotificationPreference[]
  agentAlertSubscriptions           AgentAlertSubscription[]
  notificationDeliveries            NotificationDelivery[]
  notificationWorkflows             NotificationWorkflow[]
  notificationWorkflowPolicy        NotificationWorkflowPolicy?
  notificationLlmToolPolicy         NotificationLlmToolPolicy?
  notificationWorkflowVersions      NotificationWorkflowVersion[]
  notificationWorkflowRuns          NotificationWorkflowRun[]
  notificationWorkflowStepRuns      NotificationWorkflowStepRun[]
  notificationEmailSignature        NotificationEmailSignature?
  notificationEmailBlocks           NotificationEmailBlock[]
  publicTicketStatusSettings        PublicTicketStatusSettings?
  publicTicketStatusLinks           PublicTicketStatusLink[]
  publicTicketStatusViews           PublicTicketStatusView[]
  publicFeedbackSettings            PublicFeedbackSettings?
  ticketFeedback                    TicketFeedback[]
  urgentEscalationPolicy            UrgentEscalationPolicy?
  urgentEscalationRecipients        UrgentEscalationRecipient[]
  urgentEscalationEvents            UrgentEscalationEvent[]
  ticketPriorityEvents              TicketPriorityEvent[]
  aiProviderSettings                AiProviderSetting[]
  aiProviderAttempts                AiProviderAttempt[]
  aiProviderHealthEvents            AiProviderHealthEvent[]
  channelHealthEvents               NotificationChannelHealthEvent[]
  oauthClients                      OAuthClient[]
  webhookConfig                     WorkspaceWebhookConfig?
  groups                            Group[]
  mirrorJobs                        MirrorJob[]
  mailboxConnections                MailboxConnection[]
  ticketApprovals                   TicketApproval[]
  approvalCategories                ApprovalCategory[]
  apiKeys                           ApiKey[]
  scheduledTickets                  ScheduledTicket[]
  categoryGroupLinks                CategoryGroupLink[]
  watchSubscriptions                TicketWatchSubscription[]
  replyTemplates                    ReplyTemplate[]
  quickNotes                        QuickNote[]
  ticketTags                        TicketTag[]
  webhookSubscriptions              WebhookSubscription[]
  ticketEmbeddings                  TicketEmbedding[]
  ticketTypeDefinitions             TicketTypeDefinition[]
  analyticsReports                  AnalyticsReport[]

  @@map("workspaces")
}

// Saved analytics reports (feedback 07-14): a deterministic aggregate
// snapshot + a clearly-labeled AI narrative, generated on demand for weekly
// meetings. Snapshots are immutable — regenerate to get fresh numbers.
model AnalyticsReport {
  id            Int       @id @default(autoincrement())
  workspaceId   Int       @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title         String    @db.VarChar(200)
  scope         Json // { kind: 'all'|'noise'|'category'|'subcategory'|'tag', id?, label }
  rangeStart    DateTime  @map("range_start")
  rangeEnd      DateTime  @map("range_end")
  dataset       Json // deterministic aggregates + samples
  narrative     Json? // AI sections (null when generation failed/skipped)
  llmModel      String?   @map("llm_model") @db.VarChar(100)
  createdBy     String?   @map("created_by") @db.VarChar(255)
  createdByName String?   @map("created_by_name") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("analytics_reports")
}

// Ticket attachments stored in Azure Blob Storage. Dev and prod isolate into
// separate private containers (attachments-dev / attachments-prod), selected by
// environment in attachmentService. Downloads stream through the backend —
// blobs are never publicly reachable.
model TicketAttachment {
  id            Int      @id @default(autoincrement())
  workspaceId   Int      @map("workspace_id")
  ticketId      Int      @map("ticket_id")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  threadEntryId Int?     @map("thread_entry_id")
  fileName      String   @map("file_name") @db.VarChar(255)
  contentType   String   @map("content_type") @db.VarChar(120)
  sizeBytes     Int      @map("size_bytes")
  blobName      String   @unique @map("blob_name") @db.VarChar(500)
  source        String   @default("upload") @db.VarChar(20) // upload | email
  uploadedBy    String?  @map("uploaded_by") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([workspaceId])
  @@index([threadEntryId])
  @@map("ticket_attachments")
}

// Workspace-scoped API keys for the public integration API (/api/v1).
// The raw key ("tpk_<random>") is shown once at creation; only its sha256
// hash is stored. Scopes: tickets:read, tickets:write.
model ApiKey {
  id              Int       @id @default(autoincrement())
  workspaceId     Int       @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  name            String    @db.VarChar(120)
  keyHash         String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix       String    @map("key_prefix") @db.VarChar(24)
  scopes          String[]  @default([])
  mode            String    @default("live") @db.VarChar(10) // live | test
  isEnabled       Boolean   @default(true) @map("is_enabled")
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  rotatedFromId   Int?      @map("rotated_from_id")
  ipAllowlist     String[]  @default([]) @map("ip_allowlist")
  rateLimitPerMin Int?      @map("rate_limit_per_min")
  lastUsedAt      DateTime? @map("last_used_at")
  lastUsedIp      String?   @map("last_used_ip") @db.VarChar(64)
  requestCount    Int       @default(0) @map("request_count")
  createdBy       String?   @map("created_by") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, isEnabled])
  @@map("api_keys")
}

// Built-in OAuth2 client-credentials app (workspace-scoped). Exchanges a
// client_id + client_secret at /api/v1/oauth/token for a short-lived bearer
// access token carrying this workspace + these scopes.
model OAuthClient {
  id               Int       @id @default(autoincrement())
  workspaceId      Int       @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String    @db.VarChar(120)
  clientId         String    @unique @map("client_id") @db.VarChar(40)
  clientSecretHash String    @map("client_secret_hash") @db.VarChar(64)
  secretPrefix     String    @map("secret_prefix") @db.VarChar(16)
  scopes           String[]  @default([])
  isEnabled        Boolean   @default(true) @map("is_enabled")
  revokedAt        DateTime? @map("revoked_at")
  expiresAt        DateTime? @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  lastUsedIp       String?   @map("last_used_ip") @db.VarChar(64)
  tokenCount       Int       @default(0) @map("token_count")
  createdBy        String?   @map("created_by") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, isEnabled])
  @@map("oauth_clients")
}

// Idempotency-Key replay cache for POST/PATCH writes on /api/v1 (24h TTL sweep).
model ApiIdempotencyKey {
  id           Int      @id @default(autoincrement())
  principal    String   @db.VarChar(120) // credential bucket: key:<id> | oauth:<clientId>
  apiKeyId     Int?     @map("api_key_id")
  idemKey      String   @map("idem_key") @db.VarChar(255)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(500)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  statusCode   Int?     @map("status_code") // NULL = reservation (in-flight), set on completion
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([principal, idemKey])
  @@index([createdAt])
  @@map("api_idempotency_keys")
}

// Durable fixed-window counter for /api/v1 rate limiting (per key + per IP).
model ApiRateWindow {
  id          Int    @id @default(autoincrement())
  bucketKey   String @map("bucket_key") @db.VarChar(120)
  windowEpoch Int    @map("window_epoch")
  count       Int    @default(0)

  @@unique([bucketKey, windowEpoch])
  @@index([windowEpoch])
  @@map("api_rate_windows")
}

// Per-request usage + audit log for the public API (powers per-key analytics).
model ApiRequestLog {
  id          Int      @id @default(autoincrement())
  workspaceId Int?     @map("workspace_id")
  apiKeyId    Int?     @map("api_key_id")
  method      String   @db.VarChar(10)
  path        String   @db.VarChar(500)
  scope       String?  @db.VarChar(60)
  statusCode  Int      @map("status_code")
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  durationMs  Int?     @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([apiKeyId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("api_request_logs")
}

// Tickets scheduled for a future date. The payload is a verbatim createTicket
// input replayed at activation, so triage/workflows/mirror all run exactly as
// a normal create — no half-born ticket rows sit in the queue meanwhile.
model ScheduledTicket {
  id              Int       @id @default(autoincrement())
  workspaceId     Int       @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payload         Json
  // For recurring rows this is always the NEXT fire; the sweep re-arms it
  // after each spawn instead of completing the row.
  scheduledForAt  DateTime  @map("scheduled_for_at")
  status          String    @default("pending") @db.VarChar(20) // pending | activated | completed | cancelled | error
  // Recurrence (QA 07-13 #2): none | weekly | monthly | yearly. The first
  // fire's wall-clock in `timezone` anchors the pattern (weekday for weekly,
  // day-of-month for monthly, month+day for yearly; 29-31 clamp to month end).
  recurrence      String    @default("none") @db.VarChar(10)
  recurrenceDay   Int?      @map("recurrence_day")
  recurrenceMonth Int?      @map("recurrence_month")
  timezone        String?   @db.VarChar(50)
  endAt           DateTime? @map("end_at")
  lastSpawnedAt   DateTime? @map("last_spawned_at")
  createdBy       String?   @map("created_by") @db.VarChar(255)
  createdByName   String?   @map("created_by_name") @db.VarChar(255)
  activatedAt     DateTime? @map("activated_at")
  ticketId        Int?      @map("ticket_id")
  lastError       String?   @map("last_error") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  stagedAttachments ScheduledTicketAttachment[]

  @@index([status, scheduledForAt])
  @@index([workspaceId, status])
  @@map("scheduled_tickets")
}

// Files staged against a schedule (gap plan 2 P2); adopted as real ticket
// attachments (same blob, new row) at activation. Cancel/delete cleans blobs.
model ScheduledTicketAttachment {
  id                Int             @id @default(autoincrement())
  workspaceId       Int             @map("workspace_id")
  scheduledTicketId Int             @map("scheduled_ticket_id")
  scheduledTicket   ScheduledTicket @relation(fields: [scheduledTicketId], references: [id], onDelete: Cascade)
  fileName          String          @map("file_name") @db.VarChar(255)
  contentType       String?         @map("content_type") @db.VarChar(255)
  sizeBytes         Int             @default(0) @map("size_bytes")
  blobName          String          @map("blob_name") @db.VarChar(500)
  uploadedBy        String?         @map("uploaded_by") @db.VarChar(255)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([scheduledTicketId])
  @@map("scheduled_ticket_attachments")
}

// T3.3 groundwork: category↔group affinity so AP and AR can each keep their
// own working taxonomy inside one workspace. group_id is the FS group id
// (Group.freshserviceId), matching Ticket.groupId semantics. Full admin UX later.
model CategoryGroupLink {
  id          Int                @id @default(autoincrement())
  workspaceId Int                @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  Int                @map("category_id")
  category    CompetencyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groupId     BigInt             @map("group_id")
  createdBy   String?            @map("created_by") @db.VarChar(255)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([workspaceId, categoryId, groupId])
  @@index([workspaceId, groupId])
  @@map("category_group_links")
}

// Watchers are per-CATEGORY (top/sub) or per-GROUP, never per-ticket (decision
// d7). Notifies on ticket created and/or requester replies within the scope.
model TicketWatchSubscription {
  id                   Int       @id @default(autoincrement())
  workspaceId          Int       @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userEmail            String    @map("user_email") @db.VarChar(255)
  userName             String?   @map("user_name") @db.VarChar(255)
  scopeType            String    @map("scope_type") @db.VarChar(20) // category | group
  categoryId           Int?      @map("category_id")
  groupId              BigInt?   @map("group_id")
  notifyCreated        Boolean   @default(true) @map("notify_created")
  notifyRequesterReply Boolean   @default(false) @map("notify_requester_reply")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, userEmail, scopeType, categoryId, groupId])
  @@index([workspaceId, scopeType])
  @@index([userEmail])
  @@map("ticket_watch_subscriptions")
}

// Canned reply snippets, insertable from the composer. Optionally scoped to a
// category (the mockup's category quick notes, generalized per workspace).
model ReplyTemplate {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  bodyHtml    String?   @map("body_html") @db.Text
  bodyText    String    @map("body_text") @db.Text
  categoryId  Int?      @map("category_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, isActive])
  @@map("reply_templates")
}

// Outbound webhooks (gap plan 2 P3): integrations subscribe to ticket events;
// deliveries are HMAC-SHA256 signed. Auto-disabled after sustained failures.
model WebhookSubscription {
  id               Int       @id @default(autoincrement())
  workspaceId      Int       @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url              String    @db.VarChar(1000)
  secret           String    @db.VarChar(64)
  secretPrevious   String?   @map("secret_previous") @db.VarChar(64)
  secretRotatedAt  DateTime? @map("secret_rotated_at")
  events           String[]  @default([])
  isEnabled        Boolean   @default(true) @map("is_enabled")
  disabledReason   String?   @map("disabled_reason") @db.VarChar(200)
  failureCount     Int       @default(0) @map("failure_count")
  lastDeliveryAt   DateTime? @map("last_delivery_at")
  lastError        String?   @map("last_error") @db.Text
  recentDeliveries Json?     @map("recent_deliveries")
  createdBy        String?   @map("created_by") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([workspaceId, isEnabled])
  @@map("webhook_subscriptions")
}

// Durable outbound-webhook delivery queue (survives restarts; backoff + DLQ).
model WebhookDelivery {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int                 @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspaceId    Int                 @map("workspace_id")
  eventId        String              @map("event_id") @db.VarChar(64) // webhook-id (idempotency for consumer)
  eventType      String              @map("event_type") @db.VarChar(60)
  payload        Json
  status         String              @default("pending") @db.VarChar(20) // pending | success | failed | dead
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(8) @map("max_attempts")
  nextAttemptAt  DateTime?           @map("next_attempt_at")
  lastStatusCode Int?                @map("last_status_code")
  lastError      String?             @map("last_error") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  deliveredAt    DateTime?           @map("delivered_at")

  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

// Tags (gap plan Phase 1) — a TP-owned annotation layer for BOTH ticket
// origins; never written back to FreshService. Feeds queue filters, workflow
// conditions/actions, and analytics slices.
model TicketTag {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(60)
  color       String    @default("slate") @db.VarChar(20) // named palette key, not hex
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  links TicketTagLink[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("ticket_tags")
}

model TicketTagLink {
  id        Int       @id @default(autoincrement())
  ticketId  Int       @map("ticket_id")
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId     Int       @map("tag_id")
  tag       TicketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy String?   @map("created_by") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tag_links")
}

// Content embedding for similar-ticket suggestions (gap plan 2 P5.2). One row
// per ticket; embedding is a float[] (cosine computed app-side over a bounded
// candidate set) — upgradable to pgvector once azure.extensions allows it.
// contentHash short-circuits regeneration when subject/description are unchanged.
model TicketEmbedding {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  ticketId    Int       @unique @map("ticket_id")
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  embedding   Float[]
  model       String    @db.VarChar(80)
  contentHash String    @map("content_hash") @db.VarChar(64)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, updatedAt])
  @@map("ticket_embeddings")
}

// Canned INTERNAL notes ("quick notes", QA 07-06 #12) — insertable from the
// composer's Internal-note mode. Scoped to top-level internal categories via
// internalCategoryIds (empty array = shown on every ticket). Admin-editable in
// Settings → Ticket Ops.
model QuickNote {
  id                  Int       @id @default(autoincrement())
  workspaceId         Int       @map("workspace_id")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String    @db.VarChar(120)
  bodyHtml            String?   @map("body_html") @db.Text
  bodyText            String    @map("body_text") @db.Text
  internalCategoryIds Int[]     @default([]) @map("internal_category_ids")
  isActive            Boolean   @default(true) @map("is_active")
  sortOrder           Int       @default(0) @map("sort_order")
  createdBy           String?   @map("created_by") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, isActive])
  @@map("quick_notes")
}

// Category-based ticket approvals. A request against an ApprovalCategory fans
// out one row per manager (sharing requestGroupId; any-one-approves). The
// approver decides in-app or via a magic link (hash-validated, expiring), or
// bounces it back to the requester with "info_requested". TP-only — approvals
// are never written back to FreshService.
model TicketApproval {
  id                 Int               @id @default(autoincrement())
  workspaceId        Int               @map("workspace_id")
  workspace          Workspace         @relation(fields: [workspaceId], references: [id])
  ticketId           Int               @map("ticket_id")
  ticket             Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // pending | approved | rejected | cancelled | info_requested
  status             String            @default("pending") @db.VarChar(20)
  approvalCategoryId Int?              @map("approval_category_id")
  approvalCategory   ApprovalCategory? @relation(fields: [approvalCategoryId], references: [id], onDelete: SetNull)
  // Ties the sibling approvals created from one request together (any-one-approves).
  requestGroupId     String?           @map("request_group_id") @db.VarChar(64)
  approverEmail      String            @map("approver_email") @db.VarChar(255)
  approverName       String?           @map("approver_name") @db.VarChar(255)
  requestedBy        String            @map("requested_by") @db.VarChar(255)
  requestNote        String?           @map("request_note") @db.Text
  // Sanitized rich-text variants (gap plan P2.4); the plain columns stay the
  // canonical fallback for email/text surfaces.
  requestNoteHtml    String?           @map("request_note_html") @db.Text
  // Holds the clarification question while info_requested; the decision note otherwise.
  decisionNote       String?           @map("decision_note") @db.Text
  decisionNoteHtml   String?           @map("decision_note_html") @db.Text
  // Q&A history that survives resubmits: [{question, askedBy, askedAt, answer, answeredBy, answeredAt}]
  clarificationLog   Json?             @map("clarification_log")
  decidedAt          DateTime?         @map("decided_at")
  decidedVia         String?           @map("decided_via") @db.VarChar(20) // link | app
  tokenHash          String            @unique @map("token_hash") @db.VarChar(64)
  expiresAt          DateTime?         @map("expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([workspaceId, status])
  @@index([approverEmail])
  @@index([requestGroupId])
  @@map("ticket_approvals")
}

// Per-workspace approval categories (e.g. "Laptop purchase") with designated
// approval managers. Admin-editable in Settings. managerEmails are Entra
// addresses (any one can approve); resolved to names/photos at display time.
model ApprovalCategory {
  id            Int              @id @default(autoincrement())
  workspaceId   Int              @map("workspace_id")
  workspace     Workspace        @relation(fields: [workspaceId], references: [id])
  name          String           @db.VarChar(120)
  description   String?          @db.Text
  managerEmails String[]         @default([]) @map("manager_emails")
  isActive      Boolean          @default(true) @map("is_active")
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  approvals     TicketApproval[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("approval_categories")
}

// LLM-drafted replies staged for human approval (the draft→approve pattern).
// A workflow's propose_reply node (or an auto-send node downgrading on low
// confidence / always-human match) creates one; an agent approves & sends it
// through the normal reply path, edits it first, or dismisses it.
model TicketProposedReply {
  id                Int       @id @default(autoincrement())
  workspaceId       Int       @map("workspace_id")
  ticketId          Int       @map("ticket_id")
  ticket            Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workflowRunId     Int?      @map("workflow_run_id")
  source            String    @default("workflow_llm") @db.VarChar(40) // workflow_llm | workflow_template | auto_send_downgrade
  subject           String?   @db.VarChar(500)
  bodyHtml          String?   @map("body_html") @db.Text
  bodyText          String?   @map("body_text") @db.Text
  confidence        String?   @db.VarChar(10) // low | medium | high (from the LLM output schema)
  guardSummary      Json?     @map("guard_summary")
  status            String    @default("proposed") @db.VarChar(20) // proposed | sent | dismissed
  decidedBy         String?   @map("decided_by") @db.VarChar(255)
  decidedAt         DateTime? @map("decided_at")
  sentThreadEntryId Int?      @map("sent_thread_entry_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([ticketId, status])
  @@index([workspaceId, status, createdAt])
  @@map("ticket_proposed_replies")
}

// Explicit ticket relationships (duplicate_of / related_to / parent_of).
// Directional: kind describes how `ticket` relates to `relatedTicket`.
model TicketLink {
  id              Int      @id @default(autoincrement())
  workspaceId     Int      @map("workspace_id")
  ticketId        Int      @map("ticket_id")
  ticket          Ticket   @relation("linkSource", fields: [ticketId], references: [id], onDelete: Cascade)
  relatedTicketId Int      @map("related_ticket_id")
  relatedTicket   Ticket   @relation("linkTarget", fields: [relatedTicketId], references: [id], onDelete: Cascade)
  kind            String   @db.VarChar(20) // duplicate_of | related_to | parent_of
  createdBy       String?  @map("created_by") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([ticketId, relatedTicketId, kind])
  @@index([ticketId])
  @@index([relatedTicketId])
  @@map("ticket_links")
}

// Per-ticket tasks (QA 07-16 #3). Dual-origin, mirroring the ticket model:
// TP-born tickets own their tasks in this table (and optionally mirror them to
// the FreshService fallback copy); FS-born tickets' tasks live in FreshService
// and are cached here (origin='freshservice', fsTaskId set) for rendering.
model TicketTask {
  id             Int         @id @default(autoincrement())
  workspaceId    Int         @map("workspace_id")
  ticketId       Int         @map("ticket_id")
  ticket         Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title          String      @db.VarChar(500)
  description    String?     @db.Text
  // open | in_progress | done  (maps to FreshService 1 / 2 / 3)
  status         String      @default("open") @db.VarChar(20)
  assignedTechId Int?        @map("assigned_tech_id")
  assignedTech   Technician? @relation(fields: [assignedTechId], references: [id], onDelete: SetNull)
  dueAt          DateTime?   @map("due_at")
  notifyAgent    Boolean     @default(true) @map("notify_agent")
  notifiedAt     DateTime?   @map("notified_at") // idempotency guard for the assignee email
  // 'ticketpulse' = created here; 'freshservice' = synced from FS
  origin         String      @default("ticketpulse") @db.VarChar(20)
  fsTaskId       BigInt?     @map("fs_task_id") // FreshService task id once mirrored/synced
  sortOrder      Int         @default(0) @map("sort_order")
  createdBy      String?     @map("created_by") @db.VarChar(255)
  createdByName  String?     @map("created_by_name") @db.VarChar(255)
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([workspaceId, fsTaskId])
  @@index([workspaceId, ticketId])
  @@index([assignedTechId, status])
  @@map("ticket_tasks")
}

// Ticket Pulse's own SLA targets for TP-born tickets (FS-born keep FS's SLA):
// per-priority first-response/resolution windows applied at creation.
model SlaPolicy {
  id                   Int                   @id @default(autoincrement())
  workspaceId          Int                   @map("workspace_id")
  priority             Int // 1..4
  // null = fallback row: applies to tickets of ANY type (including type-less
  // ones). A type-specific row overrides the fallback for that type only.
  // Single-fallback-per-priority is enforced by a partial unique index in the
  // migration (Postgres treats NULLs as distinct in the composite unique).
  ticketTypeId         Int?                  @map("ticket_type_id")
  ticketType           TicketTypeDefinition? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  firstResponseMinutes Int?                  @map("first_response_minutes")
  resolveMinutes       Int?                  @map("resolve_minutes")
  isActive             Boolean               @default(true) @map("is_active")
  updatedBy            String?               @map("updated_by") @db.VarChar(255)
  updatedAt            DateTime              @updatedAt @map("updated_at")
  createdAt            DateTime              @default(now()) @map("created_at")

  @@unique([workspaceId, priority, ticketTypeId])
  @@index([workspaceId, isActive])
  @@map("sla_policies")
}

// Per-workspace ticket-type catalogue. TP-native; optionally mapped to a
// FreshService ticket_type form-field choice. Retire (isActive=false), never
// delete — historical tickets keep their string value in tickets.ticket_type.
model TicketTypeDefinition {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(40) // canonical value stored on tickets.ticket_type
  description String?   @db.Text // LLM classification guidance + human tooltip
  aliases     String[]  @default([]) // normalizer inputs ("sr", "issue", "breakfix")

  // FreshService mapping. null = TP-native-only type: kept on TP tickets,
  // never written to FS (mirror + write-back skip with an explicit status).
  fsTypeValue  String?   @map("fs_type_value") @db.VarChar(40)
  fsChoiceId   BigInt?   @map("fs_choice_id") // ticket_form_fields choice id; drift detection
  fsDetectedAt DateTime? @map("fs_detected_at") // last time FS still offered this choice

  aiAssignable Boolean  @default(true) @map("ai_assignable") // LLM may pick it (Major Incident: false)
  isDefault    Boolean  @default(false) @map("is_default") // preselected on TP-born create
  color        String   @default("slate") @db.VarChar(20) // pill accent token
  abbreviation String?  @db.VarChar(6) // pill text ("INC","SR","CASE")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  source       String   @default("fs_sync") @db.VarChar(20) // fs_sync | manual
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  slaPolicies SlaPolicy[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("ticket_type_definitions")
}

// Agent quick-action bundles: one click applies status/priority/assignment/
// note together, reusing the same origin-aware write paths as manual edits.
model TicketMacro {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  name        String   @db.VarChar(120)
  description String?  @db.Text
  // { setStatus?, setPriority?, assignToTechnicianId?, addNote?, replyBody? }
  actions     Json
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdBy   String?  @map("created_by") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("ticket_macros")
}

// Create-form presets: one click pre-fills subject/description/priority/
// category on the new-ticket form (recurring request shapes).
model TicketTemplate {
  id                    Int      @id @default(autoincrement())
  workspaceId           Int      @map("workspace_id")
  name                  String   @db.VarChar(120)
  subject               String?  @db.VarChar(500)
  description           String?  @db.Text
  priority              Int? // 1..4
  ticketType            String?  @map("ticket_type") @db.VarChar(30)
  internalCategoryId    Int?     @map("internal_category_id")
  internalSubcategoryId Int?     @map("internal_subcategory_id")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdBy             String?  @map("created_by") @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("ticket_templates")
}

// Per-workspace user-defined ticket fields (pragmatic JSON UDF — values live
// in Ticket.customFields keyed by definition key; no EAV).
model CustomFieldDefinition {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  key         String   @db.VarChar(60) // machine key inside Ticket.customFields
  label       String   @db.VarChar(120)
  type        String   @default("text") @db.VarChar(20) // text | number | select | boolean | date
  options     String[] @default([]) // for select
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@index([workspaceId, isActive])
  @@map("custom_field_definitions")
}

// Monitored mailboxes for native ticketing (N per workspace). 'ingest' polls
// the inbox for new tickets / requester replies; 'send' delivers agent replies
// from this address via Microsoft Graph (proper threading); 'both' does both.
model MailboxConnection {
  id                     Int       @id @default(autoincrement())
  workspaceId            Int       @map("workspace_id")
  workspace              Workspace @relation(fields: [workspaceId], references: [id])
  address                String    @db.VarChar(255)
  displayName            String?   @map("display_name") @db.VarChar(255)
  mode                   String    @default("both") @db.VarChar(10) // ingest | send | both
  // Mailbox→group routing (AP@ → AP group, AR@ → AR group in one workspace):
  // email-born tickets inherit these. FS group id, matching Ticket.groupId.
  defaultGroupId         BigInt?   @map("default_group_id")
  defaultInternalGroupId Int?      @map("default_internal_group_id") // FK groups(id) — route to an internal (TP-native) group
  defaultInternalGroup   Group?    @relation("MailboxDefaultInternalGroup", fields: [defaultInternalGroupId], references: [id], onDelete: SetNull)
  defaultTicketType      String?   @map("default_ticket_type") @db.VarChar(30) // Incident | Service Request
  isEnabled              Boolean   @default(true) @map("is_enabled")
  pollIntervalSec        Int       @default(60) @map("poll_interval_sec")
  lastCheckedAt          DateTime? @map("last_checked_at")
  lastMessageAt          DateTime? @map("last_message_at")
  lastError              String?   @map("last_error") @db.Text
  lastErrorAt            DateTime? @map("last_error_at")
  createdBy              String?   @map("created_by") @db.VarChar(255)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, address])
  @@index([isEnabled])
  @@map("mailbox_connections")
}

model WorkspaceWebhookConfig {
  id               Int       @id @default(autoincrement())
  workspaceId      Int       @unique @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled          Boolean   @default(false)
  secretHash       String?   @map("secret_hash") @db.VarChar(255)
  secretLast4      String?   @map("secret_last4") @db.VarChar(8)
  lastReceivedAt   DateTime? @map("last_received_at")
  lastAcceptedAt   DateTime? @map("last_accepted_at")
  lastRejectedAt   DateTime? @map("last_rejected_at")
  lastErrorAt      DateTime? @map("last_error_at")
  lastErrorMessage String?   @map("last_error_message") @db.Text
  receivedCount    Int       @default(0) @map("received_count")
  acceptedCount    Int       @default(0) @map("accepted_count")
  rejectedCount    Int       @default(0) @map("rejected_count")
  errorCount       Int       @default(0) @map("error_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, enabled])
  @@map("workspace_webhook_configs")
}

model WorkspaceAccess {
  id          Int       @id @default(autoincrement())
  email       String    @db.VarChar(255)
  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  role        String    @default("viewer") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([email, workspaceId])
  @@index([email])
  @@map("workspace_access")
}

model Technician {
  id              Int       @id @default(autoincrement())
  freshserviceId  BigInt?   @map("freshservice_id") // null for local (non-FreshService) agents
  origin          String    @default("freshservice") @map("origin") @db.VarChar(20) // freshservice | local
  name            String    @db.VarChar(255)
  email           String?   @db.VarChar(255)
  photoUrl        String?   @map("photo_url") @db.Text
  timezone        String    @default("America/Los_Angeles") @db.VarChar(50)
  location        String?   @db.VarChar(100)
  workspaceId     Int       @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  isActive        Boolean   @default(true) @map("is_active")
  photoSyncedAt   DateTime? @map("photo_synced_at")
  showOnMap       Boolean   @default(true) @map("show_on_map")
  isMapManager    Boolean   @default(false) @map("is_map_manager")
  workStartTime   String?   @map("work_start_time") @db.VarChar(5)
  workEndTime     String?   @map("work_end_time") @db.VarChar(5)
  // Standing instruction the assignment AI sees whenever this person is a
  // candidate (e.g. "Reduced ticket capacity — only recommend for a
  // significantly stronger skill match or their specialty categories").
  routingGuidance String?   @map("routing_guidance") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tickets                    Ticket[]
  leaves                     TechnicianLeave[]
  vtUserMappings             VtUserMapping[]
  calendarLeaveAliases       CalendarLeaveAlias[]
  assignmentsReceived        TicketAssignment[]                @relation("assignedTo")
  competencies               TechnicianCompetency[]
  pipelineAssignments        AssignmentPipelineRun[]           @relation("pipelineAssignedTo")
  assignmentCorrectionsFrom  AssignmentCorrection[]            @relation("correctionFromTech")
  assignmentCorrectionsTo    AssignmentCorrection[]            @relation("correctionToTech")
  competencyRuns             CompetencyAnalysisRun[]
  competencyChangeRequests   CompetencyChangeRequest[]
  assignmentEpisodes         TicketAssignmentEpisode[]
  notificationPreference     TechnicianNotificationPreference?
  notificationDeliveries     NotificationDelivery[]
  urgentEscalationRecipients UrgentEscalationRecipient[]
  groupMemberships           GroupMember[]
  ticketTasks                TicketTask[]
  agentAlertSubscriptions    AgentAlertSubscription[]

  @@unique([freshserviceId, workspaceId])
  @@index([freshserviceId])
  @@index([workspaceId])
  @@index([email])
  @@index([origin])
  @@map("technicians")
}

model Requester {
  id                     Int       @id @default(autoincrement())
  // Nullable: requesters created for TP-born tickets may not exist in FS yet;
  // the mirror backfills this once FS auto-creates them during ticket mirroring.
  freshserviceId         BigInt?   @unique @map("freshservice_id")
  name                   String    @db.VarChar(255)
  email                  String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(50)
  mobile                 String?   @db.VarChar(50)
  department             String?   @db.VarChar(255)
  jobTitle               String?   @map("job_title") @db.VarChar(255)
  timeZone               String?   @map("time_zone") @db.VarChar(100)
  language               String?   @db.VarChar(50)
  entraOfficeLocation    String?   @map("entra_office_location") @db.VarChar(255)
  entraCity              String?   @map("entra_city") @db.VarChar(255)
  entraState             String?   @map("entra_state") @db.VarChar(100)
  entraCountry           String?   @map("entra_country") @db.VarChar(100)
  entraCountryCode       String?   @map("entra_country_code") @db.VarChar(10)
  entraDepartment        String?   @map("entra_department") @db.VarChar(255)
  entraJobTitle          String?   @map("entra_job_title") @db.VarChar(255)
  entraPreferredLanguage String?   @map("entra_preferred_language") @db.VarChar(50)
  entraProfileSyncedAt   DateTime? @map("entra_profile_synced_at")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tickets Ticket[]

  @@index([freshserviceId])
  @@index([email])
  @@index([entraOfficeLocation])
  @@index([entraCountry])
  @@map("requesters")
}

model Ticket {
  id                        Int       @id @default(autoincrement())
  // Nullable: tickets born inside Ticket Pulse (origin='ticketpulse') have no FS id
  // until the mirror creates their FreshService copy. Postgres unique tolerates NULLs.
  freshserviceTicketId      BigInt?   @unique @map("freshservice_ticket_id")
  // 'freshservice' = synced from FS (FS owns it; sync may write to it)
  // 'ticketpulse'  = born in this app (TP owns it; FS ingest must NEVER write to it)
  origin                    String    @default("freshservice") @db.VarChar(20)
  // TP-native ticket number (displayed as "TP-<n>"), from ticket_native_number_seq.
  // Only populated for origin='ticketpulse'.
  nativeNumber              Int?      @unique @map("native_number")
  // Fallback-mirror bookkeeping (origin='ticketpulse' only):
  // null = not applicable / not yet queued, then pending | mirrored | error
  mirrorState               String?   @map("mirror_state") @db.VarChar(20)
  mirroredAt                DateTime? @map("mirrored_at")
  mirrorError               String?   @map("mirror_error") @db.Text
  subject                   String?   @db.Text
  description               String?   @db.Text
  descriptionText           String?   @map("description_text") @db.Text
  status                    String    @db.VarChar(50)
  priority                  Int       @default(3)
  // Optional ITSM impact/urgency (gap plan P2.5): 1=Low 2=Medium 3=High.
  // TP-side annotations on both origins; priority remains the operative field.
  impact                    Int?      @db.SmallInt
  urgency                   Int?      @db.SmallInt
  // Requester sentiment (gap plan 2 P5.1): positive | neutral | frustrated.
  // TEAM-SAFE: describes the REQUESTER's state in their own messages — never
  // agent performance, never aggregated per agent.
  sentiment                 String?   @db.VarChar(16)
  sentimentComputedAt       DateTime? @map("sentiment_computed_at")
  assessedPriority          String?   @map("assessed_priority") @db.VarChar(20)
  assessedPriorityId        Int?      @map("assessed_priority_id")
  priorityRationale         String?   @map("priority_rationale") @db.Text
  priorityConfidence        String?   @map("priority_confidence") @db.VarChar(20)
  priorityEvidence          Json?     @map("priority_evidence")
  priorityAssessedAt        DateTime? @map("priority_assessed_at")
  priorityAssessedByRunId   Int?      @map("priority_assessed_by_run_id")
  ticketType                String?   @map("ticket_type") @db.VarChar(40)
  assessedTicketType        String?   @map("assessed_ticket_type") @db.VarChar(40)
  ticketTypeRationale       String?   @map("ticket_type_rationale") @db.Text
  ticketTypeConfidence      String?   @map("ticket_type_confidence") @db.VarChar(20)
  ticketTypeAssessedAt      DateTime? @map("ticket_type_assessed_at")
  ticketTypeAssessedByRunId Int?      @map("ticket_type_assessed_by_run_id")

  // Workspace
  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Relationships
  assignedTechId Int?        @map("assigned_tech_id")
  assignedTech   Technician? @relation(fields: [assignedTechId], references: [id])

  // Requester relationship
  requesterId             Int?       @map("requester_id") // Internal DB ID
  requester               Requester? @relation(fields: [requesterId], references: [id])
  requesterFreshserviceId BigInt?    @map("requester_freshservice_id") // FreshService requester ID (for mapping)

  // Timestamps
  createdAt                           DateTime  @map("created_at")
  assignedAt                          DateTime? @map("assigned_at")
  resolvedAt                          DateTime? @map("resolved_at")
  closedAt                            DateTime? @map("closed_at")
  dueBy                               DateTime? @map("due_by")
  frDueBy                             DateTime? @map("fr_due_by") // First response due by
  updatedAt                           DateTime  @updatedAt @map("updated_at")
  freshserviceUpdatedAt               DateTime? @map("freshservice_updated_at")
  // Last REAL activity (message, assignment, status change) — updated_at and
  // freshservice_updated_at both get bumped by system/sync noise; this doesn't.
  lastRealActivityAt                  DateTime? @map("last_real_activity_at")
  lastIngestSource                    String?   @map("last_ingest_source") @db.VarChar(60)
  lastIngestedAt                      DateTime? @map("last_ingested_at")
  lastWebhookIngestedAt               DateTime? @map("last_webhook_ingested_at")
  webhookIngestCount                  Int       @default(0) @map("webhook_ingest_count")
  activitiesSyncedAt                  DateTime? @map("activities_synced_at")
  activitiesSyncFreshserviceUpdatedAt DateTime? @map("activities_sync_freshservice_updated_at")
  activitiesSyncError                 String?   @map("activities_sync_error") @db.Text
  activitiesSyncErrorAt               DateTime? @map("activities_sync_error_at")

  // Assignment tracking
  isSelfPicked Boolean @default(false) @map("is_self_picked")
  assignedBy   String? @map("assigned_by") @db.VarChar(255) // Name or ID

  // Additional metadata
  source                           Int? // 1=Email, 2=Portal, 3=Phone, etc.
  toEmails                         String[]            @default([]) @map("to_emails")
  ccEmails                         String[]            @default([]) @map("cc_emails")
  replyCcEmails                    String[]            @default([]) @map("reply_cc_emails")
  fwdEmails                        String[]            @default([]) @map("fwd_emails")
  category                         String?             @db.VarChar(255)
  subCategory                      String?             @map("sub_category") @db.VarChar(255)
  ticketCategory                   String?             @map("ticket_category") @db.VarChar(100) // Custom field: security (e.g., BST, GIS, etc.)
  tpSkill                          String?             @map("tp_skill") @db.VarChar(120)
  tpSubskill                       String?             @map("tp_subskill") @db.VarChar(120)
  internalCategoryId               Int?                @map("internal_category_id")
  internalCategory                 CompetencyCategory? @relation("TicketInternalCategory", fields: [internalCategoryId], references: [id], onDelete: SetNull)
  internalSubcategoryId            Int?                @map("internal_subcategory_id")
  internalSubcategory              CompetencyCategory? @relation("TicketInternalSubcategory", fields: [internalSubcategoryId], references: [id], onDelete: SetNull)
  internalCategoryConfidence       String?             @map("internal_category_confidence") @db.VarChar(20)
  internalCategoryRationale        String?             @map("internal_category_rationale") @db.Text
  internalCategoryFit              String?             @map("internal_category_fit") @db.VarChar(30)
  internalSubcategoryFit           String?             @map("internal_subcategory_fit") @db.VarChar(30)
  taxonomyReviewNeeded             Boolean             @default(false) @map("taxonomy_review_needed")
  suggestedInternalCategoryName    String?             @map("suggested_internal_category_name") @db.VarChar(120)
  suggestedInternalSubcategoryName String?             @map("suggested_internal_subcategory_name") @db.VarChar(120)
  department                       String?             @db.VarChar(255)
  isEscalated                      Boolean?            @default(false) @map("is_escalated")

  // Time tracking (from FreshService stats)
  timeSpentMinutes        Int?      @map("time_spent_minutes") // Total time spent in minutes (requires time_entries API)
  billableMinutes         Int?      @map("billable_minutes") // Billable time in minutes (requires time_entries API)
  nonBillableMinutes      Int?      @map("non_billable_minutes") // Non-billable time in minutes (requires time_entries API)
  resolutionTimeSeconds   Int?      @map("resolution_time_seconds") // Time from creation to resolution (from stats field)
  firstAssignedAt         DateTime? @map("first_assigned_at") // When ticket was first assigned (from activities API)
  firstPublicAgentReplyAt DateTime? @map("first_public_agent_reply_at") // First public agent reply timestamp (from activities API)

  // Workspace filtering
  workspaceName String? @map("workspace_name") @db.VarChar(100)

  // CSAT (Customer Satisfaction Survey)
  csatResponseId    BigInt?   @map("csat_response_id") // FreshService CSAT response ID
  csatScore         Int?      @map("csat_score") // Acquired score (1-4)
  csatTotalScore    Int?      @map("csat_total_score") // Total possible score (usually 4)
  csatRatingText    String?   @map("csat_rating_text") @db.VarChar(50) // "Poor", "Good", "Excellent", etc.
  csatOverallRating Int?      @map("csat_overall_rating") // FreshService rating code (e.g., 301)
  csatFeedback      String?   @map("csat_feedback") @db.Text // User's detailed feedback/comments
  csatSubmittedAt   DateTime? @map("csat_submitted_at") // When survey was submitted

  // Noise detection
  isNoise          Boolean @default(false) @map("is_noise")
  noiseRuleMatched String? @map("noise_rule_matched") @db.VarChar(100)

  // Bounce / rejection tracking
  rejectionCount  Int     @default(0) @map("rejection_count")
  groupId         BigInt? @map("group_id") // FreshService group id (FS-synced groups)
  internalGroupId Int?    @map("internal_group_id") // FK groups(id) for internal (TP-native) groups
  internalGroup   Group?  @relation("TicketInternalGroup", fields: [internalGroupId], references: [id], onDelete: SetNull)

  // CSAT sync bookkeeping — when we last asked FS for this ticket's CSAT
  // response. Lets the scheduled CSAT sweep walk through the backlog
  // instead of re-checking the same 30 freshly-synced tickets every cycle.
  csatCheckedAt DateTime? @map("csat_checked_at")

  ticketAssignments        TicketAssignment[]
  pipelineRuns             AssignmentPipelineRun[]
  assignmentCorrections    AssignmentCorrection[]
  assignmentEpisodes       TicketAssignmentEpisode[]
  threadEntries            TicketThreadEntry[]
  notificationDeliveries   NotificationDelivery[]
  notificationWorkflowRuns NotificationWorkflowRun[]
  publicStatusLinks        PublicTicketStatusLink[]
  publicStatusViews        PublicTicketStatusView[]
  feedback                 TicketFeedback?
  urgentEscalationEvents   UrgentEscalationEvent[]
  priorityEvents           TicketPriorityEvent[]
  mirrorJobs               MirrorJob[]
  approvals                TicketApproval[]
  attachments              TicketAttachment[]
  proposedReplies          TicketProposedReply[]
  linksFrom                TicketLink[]              @relation("linkSource")
  linksTo                  TicketLink[]              @relation("linkTarget")
  tagLinks                 TicketTagLink[]
  tasks                    TicketTask[]
  embedding                TicketEmbedding?

  // Per-workspace user-defined fields — values keyed by CustomFieldDefinition.key.
  customFields Json? @map("custom_fields")

  @@index([workspaceId])
  @@index([workspaceId, lastRealActivityAt(sort: Desc)])
  @@index([assignedTechId])
  // Dashboard workload scan: open/pending tickets per tech, scoped to a
  // workspace. Serves getAllActiveScoped's unbounded status branch so a large
  // backlog (Accounting) no longer forces a status-only full scan (QA 07-23 #6).
  @@index([workspaceId, status])
  @@index([assignedTechId, status])
  @@index([createdAt])
  @@index([status])
  @@index([workspaceName])
  @@index([requesterId])
  @@index([csatScore])
  @@index([csatSubmittedAt])
  @@index([firstPublicAgentReplyAt])
  @@index([firstAssignedAt])
  @@index([isNoise])
  @@index([freshserviceUpdatedAt])
  @@index([lastIngestSource])
  @@index([workspaceId, lastWebhookIngestedAt])
  @@index([activitiesSyncFreshserviceUpdatedAt])
  @@index([assessedPriorityId])
  @@index([priorityAssessedAt])
  @@index([ticketType])
  @@index([assessedTicketType])
  @@index([ticketTypeAssessedAt])
  @@index([tpSkill])
  @@index([tpSubskill])
  @@index([internalCategoryId])
  @@index([internalSubcategoryId])
  @@index([taxonomyReviewNeeded])
  @@index([workspaceId, origin])
  @@index([mirrorState])
  @@map("tickets")
}

