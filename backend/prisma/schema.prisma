model TicketThreadEntry {
  id                  Int       @id @default(autoincrement())
  ticketId            Int       @map("ticket_id")
  ticket              Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workspaceId         Int       @map("workspace_id")
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  // Nullable: entries authored inside Ticket Pulse (source='ticketpulse_user') have
  // no FreshService entry id. FS-sourced entries keep it for dedupe on re-sync.
  externalEntryId     String?   @map("external_entry_id") @db.VarChar(191)
  // freshservice_activity | freshservice_conversation | webhook | ticketpulse_user | email_inbound
  source              String    @default("freshservice_activity") @db.VarChar(50)
  eventType           String    @default("activity") @map("event_type") @db.VarChar(50)
  actorName           String?   @map("actor_name") @db.VarChar(255)
  actorEmail          String?   @map("actor_email") @db.VarChar(255)
  actorFreshserviceId BigInt?   @map("actor_freshservice_id")
  authorType          String?   @map("author_type") @db.VarChar(20) // agent | requester | system
  // Fallback-mirror bookkeeping for TP-authored entries: pending | mirrored | error
  mirrorState         String?   @map("mirror_state") @db.VarChar(20)
  mirroredAt          DateTime? @map("mirrored_at")
  // RFC 5322 Message-ID for email threading: outbound Graph sends store theirs
  // so inbound In-Reply-To/References headers match replies back to the ticket.
  emailMessageId      String?   @map("email_message_id") @db.VarChar(998)
  incoming            Boolean?  @map("incoming")
  isPrivate           Boolean?  @map("is_private")
  visibility          String?   @db.VarChar(20)
  title               String?   @db.VarChar(255)
  content             String?   @db.Text
  bodyHtml            String?   @map("body_html") @db.Text
  bodyText            String?   @map("body_text") @db.Text
  occurredAt          DateTime  @map("occurred_at")
  syncedAt            DateTime  @default(now()) @map("synced_at")
  rawPayload          Json?     @map("raw_payload")

  @@unique([ticketId, externalEntryId])
  @@index([workspaceId, occurredAt])
  @@index([ticketId, occurredAt])
  @@index([eventType])
  @@index([emailMessageId])
  @@map("ticket_thread_entries")
}

// Outbox for the FreshService fallback mirror. Every TP-born mutation that must
// reach the FS copy becomes a job; jobs for one ticket apply strictly in id
// order (create_ticket first). Retry with backoff; dead jobs surface on the
// ticket as mirrorState='error'.
model MirrorJob {
  id            Int       @id @default(autoincrement())
  workspaceId   Int       @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  ticketId      Int       @map("ticket_id")
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  threadEntryId Int?      @map("thread_entry_id")
  kind          String    @db.VarChar(30) // create_ticket | update_fields | thread_entry | delete_thread_entry | delete_ticket
  // Free-form job context that must survive the source row being deleted — e.g.
  // the FS conversation id for a delete_thread_entry job (the local entry is
  // already gone by the time the job runs).
  payload       Json?     @map("payload")
  status        String    @default("pending") @db.VarChar(20) // pending | done | failed | dead
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([ticketId, id])
  @@index([workspaceId, status])
  @@map("mirror_jobs")
}

// Cache of FreshService agent groups (per workspace). Tickets keep storing the raw
// FS group id in Ticket.groupId; this table gives it a name and powers group pickers.
// freshserviceId is nullable so TP-native groups are possible later.
model Group {
  id             Int       @id @default(autoincrement())
