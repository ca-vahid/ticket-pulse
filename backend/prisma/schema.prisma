model AssignmentConfig {
  id                                  Int       @id @default(autoincrement())
  workspaceId                         Int       @unique @map("workspace_id")
  workspace                           Workspace @relation(fields: [workspaceId], references: [id])
  isEnabled                           Boolean   @default(false) @map("is_enabled")
  autoAssign                          Boolean   @default(false) @map("auto_assign")
  llmModel                            String    @default("claude-sonnet-5") @map("llm_model") @db.VarChar(100)
  maxRecommendations                  Int       @default(3) @map("max_recommendations")
  scoringWeights                      Json?     @map("scoring_weights") // { competency: 0.35, workload: 0.30, location: 0.20, recency: 0.15 }
  classificationPrompt                String?   @map("classification_prompt") @db.Text
  categorizationPrompt                String?   @map("categorization_prompt") @db.Text
  recommendationPrompt                String?   @map("recommendation_prompt") @db.Text
  feedbackContext                     String?   @map("feedback_context") @db.Text // accumulated knowledge from admin overrides
  pollForUnassigned                   Boolean   @default(true) @map("poll_for_unassigned")
  pollMaxPerCycle                     Int       @default(5) @map("poll_max_per_cycle")
  monitoredMailbox                    String?   @map("monitored_mailbox") @db.VarChar(255)
  emailPollingEnabled                 Boolean   @default(false) @map("email_polling_enabled")
  emailPollingIntervalSec             Int       @default(60) @map("email_polling_interval_sec")
  lastEmailCheckAt                    DateTime? @map("last_email_check_at")
  autoCloseNoise                      Boolean   @default(false) @map("auto_close_noise")
  dryRunMode                          Boolean   @default(true) @map("dry_run_mode")
  dailyReviewEnabled                  Boolean   @default(false) @map("daily_review_enabled")
  dailyReviewRunHour                  Int       @default(18) @map("daily_review_run_hour")
  dailyReviewRunMinute                Int       @default(5) @map("daily_review_run_minute")
  dailyReviewLookbackDays             Int       @default(14) @map("daily_review_lookback_days")
  // When true, the regular 5-min sync proactively pulls FreshService
  // activity + conversation data for today's ticket cohort so the daily
  // review can run with a near-warm cache. Off by default — workspaces
  // that don't use Daily Review shouldn't pay the FS API budget tax.
  dailyReviewPreheatEnabled           Boolean   @default(false) @map("daily_review_preheat_enabled")
  priorityAssessmentEnabled           Boolean   @default(true) @map("priority_assessment_enabled")
  priorityWritebackEnabled            Boolean   @default(true) @map("priority_writeback_enabled")
  priorityAssessmentAfterHoursEnabled Boolean   @default(false) @map("priority_assessment_after_hours_enabled")
  afterHoursUrgentEscalationEnabled   Boolean   @default(false) @map("after_hours_urgent_escalation_enabled")
  afterHoursUrgentEscalationChannels  String[]  @default([]) @map("after_hours_urgent_escalation_channels")
  afterHoursUrgentEscalationEmails    String[]  @default([]) @map("after_hours_urgent_escalation_emails")
  afterHoursUrgentEscalationPhones    String[]  @default([]) @map("after_hours_urgent_escalation_phones")
  // FreshService group IDs that are excluded from auto-assignment. When a
  // ticket's group_id is in this list, the LLM still runs and produces a
  // recommendation, but decision is forced to pending_review for manual
  // approval — even when autoAssign=true. Empty array = no exclusions.
  excludedGroupIds                    Int[]     @default([]) @map("excluded_group_ids")
  // FreshService group IDs in OBSERVE-ONLY (mock) mode. The pipeline still
  // runs and records what it WOULD have done (visible in the review queue),
  // but writes NOTHING to the ticket: no assignment, no noise flag, no
  // category/priority/type persistence, no FS write-back. Decision is forced
  // to pending_review. Built for the AR onboarding observation window.
  observeOnlyGroupIds                 Int[]     @default([]) @map("observe_only_group_ids")
  // Auto-apply AI categories to FreshService even while assignment is
  // human-gated (pending_review) or the run was priority-only (after-hours).
  autoCategorizeEnabled               Boolean   @default(false) @map("auto_categorize_enabled")
  // Observation carve-out: when true, observe-only groups still get the AI's
  // CATEGORY applied (persisted on the ticket; FS write-back rides
  // autoCategorizeEnabled) while assignment/noise/priority/type stay mocked.
  observeCategoryWritebackEnabled     Boolean   @default(false) @map("observe_category_writeback_enabled")
  // FS write-back of the LLM's assessed ticket TYPE. Replaces the old
  // SKILL_HIERARCHY_WORKSPACE_IDS env gate for type (migration seeds ws1
  // true to preserve behavior). Only types with an fsTypeValue mapping in
  // ticket_type_definitions are ever sent.
  typeWritebackEnabled                Boolean   @default(false) @map("type_writeback_enabled")
  createdAt                           DateTime  @default(now()) @map("created_at")
  updatedAt                           DateTime  @updatedAt @map("updated_at")

  @@map("assignment_configs")
}

