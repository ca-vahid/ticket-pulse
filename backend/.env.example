# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketpulse

# Session Security
SESSION_SECRET=your-super-secret-session-key-change-this

# FreshService API Configuration
FRESHSERVICE_API_KEY=your-freshservice-api-key-here
FRESHSERVICE_DOMAIN=your-domain.freshservice.com
FRESHSERVICE_WORKSPACE_ID=your-workspace-id
# Production auto-starts scheduled sync by default. Development/test do not.
# Set true only when this backend should poll/write live Freshservice.
ENABLE_SCHEDULED_SYNC=false

# Authentication
ADMIN_PASSWORD_HASH=$2b$10$your-bcrypt-hashed-password-here

# CORS - comma-separated list of allowed origins (production only)
CORS_ORIGIN=https://brave-dune-056d0421e.6.azurestaticapps.net

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Azure Graph API (Backend - email monitoring for assignment pipeline)
AZURE_GRAPH_TENANT_ID=your-azure-tenant-id
AZURE_GRAPH_CLIENT_ID=your-backend-app-client-id
AZURE_GRAPH_CLIENT_SECRET=your-backend-app-client-secret

# Microsoft Graph change notifications for ticket mailboxes (Mega 08-31 MB-2).
# Off by default: dev machines are unreachable by Graph, so the mailbox poller
# stays the inbound lane. Prod sets GRAPH_NOTIFICATIONS_ENABLED=true; the base
# URL must be the public https origin of THIS backend (Graph POSTs to
# <base>/api/graph-notifications and <base>/api/graph-lifecycle). When unset in
# production it defaults to https://api.ticketpulse.bgcsaas.com.
GRAPH_NOTIFICATIONS_ENABLED=false
GRAPH_NOTIFICATION_BASE_URL=
# Optional: comma-separated exact IPs or prefixes (e.g. "52.159.,20.20.32.") that
# may POST notifications; empty = no IP gate (clientState is still checked).
GRAPH_NOTIFICATION_IP_ALLOWLIST=
# Poller cadence for mailboxes whose webhook is live (delta catch-up), ms; 1–15 min.
MAILBOX_CATCHUP_INTERVAL_MS=300000

# Azure Configuration (Production Only)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# APPLICATION_INSIGHTS_KEY=your-app-insights-key

# Logging
LOG_LEVEL=info
